+		if (!s->IsValid()) return false;
+		static char buf[8192] {};
+		std::int64_t n = s->Read(buf, sizeof(buf) - 1);
+		buf[n > 0 ? n : 0] = '\0';
+		char* line = buf;
+		while (line != nullptr && *line != '\0' && TestCount < std::int32_t(arraySize(Tests))) {
+			char* next = std::strchr(line, '\n');
+			if (next != nullptr) *next++ = '\0';
