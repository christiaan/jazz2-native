+		int n = std::vsnprintf(Out + OutLength, sizeof(Out) - OutLength, fmt, args);
+		va_end(args);
+		if (n > 0) OutLength = std::min(OutLength + std::size_t(n), sizeof(Out) - 1);
+	}
+	static void Flush() {
